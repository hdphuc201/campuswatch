{
  "name": "@campuswatch/portal-core",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only Portal adapter contract, capability declarations, fingerprinting, and diffing.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@campuswatch/contracts": "workspace:*"
  },
  "devDependencies": {
    "@campuswatch/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
