# Staging environment for infra/deploy/docker-compose.staging.yml.
# Copy to infra/deploy/staging.env (git-ignored) and fill in. Never commit real values.
# Generate random values with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"

# Public hostname of the API (DNS must point to this host; Caddy obtains the certificate).
API_DOMAIN=

# PostgreSQL (internal to the compose network).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# 32+ random characters.
AUTH_SECRET=

# Optional: bearer token for /ops/metrics (blocked at Caddy; scrape from the internal network).
OPS_METRICS_TOKEN=

# Optional Telegram (all four or none). See docs/runbooks/telegram.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# 32 random bytes, base64.
ENCRYPTION_KEY=

LOG_LEVEL=
