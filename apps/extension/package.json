{
  "name": "@campuswatch/extension",
  "version": "0.1.0",
  "private": true,
  "description": "CampusWatch Chrome Extension (WXT, React, Manifest V3).",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "lint": "eslint .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@campuswatch/citd-adapter": "workspace:*",
    "@campuswatch/contracts": "workspace:*",
    "@campuswatch/notifications": "workspace:*",
    "@campuswatch/portal-core": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@campuswatch/config": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "8.3.8",
    "vitest": "catalog:",
    "wxt": "0.21.5"
  }
}
