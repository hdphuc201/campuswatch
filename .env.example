# Copy to .env for local overrides. Never commit .env.
# Values are intentionally empty: defaults for local development are documented
# in docs/runbooks/local-development.md. Never put CITD Portal credentials here.

# Shared
NODE_ENV=
LOG_LEVEL=

# API
API_HOST=
API_PORT=
DATABASE_URL=
DATABASE_POOL_MAX=
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=
REFRESH_TOKEN_TTL_DAYS=
# Rate limits (shared counters need REDIS_URL, below). Cannot be disabled in production.
RATE_LIMITS_ENABLED=
# Number of trusted reverse proxies in front of the API (0 = none).
TRUST_PROXY_HOPS=
# Bearer token for GET /ops/metrics (32+ characters); unset disables the endpoint.
OPS_METRICS_TOKEN=

# Telegram (optional; all four on the API, token + key on the worker). See docs/runbooks/telegram.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# 32 random bytes, base64. Encrypts Telegram chat ids at rest.
ENCRYPTION_KEY=

# API rate limits and worker queues (also read by the worker: DATABASE_URL, TELEGRAM_BOT_TOKEN, ENCRYPTION_KEY)
REDIS_URL=
TELEGRAM_DISPATCH_INTERVAL_SECONDS=
RETENTION_HISTORY_DAYS=
RETENTION_OPERATIONAL_DAYS=

# Integration tests: admin connection used to create throwaway databases
TEST_DATABASE_URL=

# Local infrastructure (infra/docker-compose.yml)
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
REDIS_PORT=
