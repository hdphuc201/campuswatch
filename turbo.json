{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "db:migrate": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NODE_ENV",
        "LOG_LEVEL",
        "API_HOST",
        "API_PORT",
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "AUTH_SECRET",
        "ACCESS_TOKEN_TTL_SECONDS",
        "REFRESH_TOKEN_TTL_DAYS",
        "REDIS_URL",
        "TELEGRAM_BOT_TOKEN",
        "TELEGRAM_BOT_USERNAME",
        "TELEGRAM_WEBHOOK_SECRET",
        "ENCRYPTION_KEY",
        "TELEGRAM_DISPATCH_INTERVAL_SECONDS",
        "RATE_LIMITS_ENABLED",
        "TRUST_PROXY_HOPS",
        "OPS_METRICS_TOKEN",
        "RETENTION_HISTORY_DAYS",
        "RETENTION_OPERATIONAL_DAYS"
      ]
    }
  }
}
